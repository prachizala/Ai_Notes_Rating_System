# ==========================================
# NoteIQ - Environment Configuration Example
# ==========================================

# App
APP_NAME=NoteIQ
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Database / cache
DATABASE_URL=postgresql+psycopg://noteiq:noteiq@localhost:5432/noteiq
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=super-secret-jwt-key-replace-in-production-at-least-32-chars
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=14
COOKIE_SECURE=false

# Storage (S3 compatible - e.g. MinIO, Cloudflare R2, AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=noteiq-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto
SIGNED_URL_EXPIRE_SECONDS=300
MAX_UPLOAD_MB=25

# AI Provider Configuration
LLM_PROVIDER=gemini            # gemini | anthropic | openai
LLM_API_KEY=
LLM_MODEL_ANALYSIS=gemini-2.5-flash
LLM_MODEL_CHAT=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini      # gemini | openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
ANALYSIS_RUBRIC_VERSION=v1

# Limits
CHAT_RATE_LIMIT_PER_HOUR=60
UPLOAD_RATE_LIMIT_PER_DAY=20
MAX_ANALYSIS_CHARS=400000
CLAMAV_ENABLED=false
